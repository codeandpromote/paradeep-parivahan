# Base URL of the Core PHP REST API (Agent 4). No trailing slash.
NEXT_PUBLIC_API_BASE=https://api.paradeepparivahan.com/api

# Host that serves /uploads/** assets (PDFs, images).
# LEAVE EMPTY to use the local copies bundled in frontend/public/uploads (default).
# Set to the PHP host only if you later serve assets from there instead.
NEXT_PUBLIC_ASSET_HOST=
